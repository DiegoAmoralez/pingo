FROM node:22-alpine AS deps
RUN apk add --no-cache libc6-compat openssl
RUN corepack enable && corepack prepare pnpm@11.15.1 --activate
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/monitoring/package.json packages/monitoring/package.json
COPY packages/notifications/package.json packages/notifications/package.json
COPY packages/billing/package.json packages/billing/package.json
COPY packages/email/package.json packages/email/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/telegram-bot/package.json packages/telegram-bot/package.json
RUN pnpm install --frozen-lockfile

FROM node:22-alpine AS builder
RUN apk add --no-cache libc6-compat openssl
RUN corepack enable && corepack prepare pnpm@11.15.1 --activate
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/worker/node_modules ./apps/worker/node_modules
COPY --from=deps /app/packages ./packages
COPY . .
RUN pnpm --filter @pingo/database generate
RUN pnpm --filter @pingo/worker build
# Isolated production tree with only runtime deps (@prisma/client, bullmq, …).
RUN pnpm --filter @pingo/worker deploy --prod --legacy /deploy
# pnpm deploy may leave a broken @prisma/client symlink; replace with generated client+engine.
RUN set -eux; \
  CLIENT_ROOT="$(ls -d /app/node_modules/.pnpm/@prisma+client@*/node_modules | head -n 1)"; \
  rm -rf /deploy/node_modules/@prisma /deploy/node_modules/.prisma; \
  mkdir -p /deploy/node_modules; \
  cp -a "${CLIENT_ROOT}/@prisma" /deploy/node_modules/; \
  cp -a "${CLIENT_ROOT}/.prisma" /deploy/node_modules/

FROM node:22-alpine AS runner
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 pingo
COPY --from=builder --chown=pingo:nodejs /deploy ./
COPY --from=builder --chown=pingo:nodejs /app/apps/worker/dist ./dist
USER pingo
CMD ["node", "dist/index.js"]
