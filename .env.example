# Application
NODE_ENV=development
# Public HTTPS URL is required for Telegram Mini App buttons (https://your-domain.com)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
MOCK_MONITORING=false

# Database
DATABASE_URL=postgresql://pingo:pingo@localhost:5432/pingo?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=PingoMonitorBot
TELEGRAM_WEBHOOK_SECRET=

# Stripe — two worlds, switched from /admin without a redeploy.
# Sandbox (test) keys: sk_test_… / rk_test_…
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
# Live keys: sk_live_… / rk_live_… (leave empty until you are ready to charge real cards)
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
# Mode used before an admin picks one (defaults to test when it is configured)
# STRIPE_DEFAULT_MODE=test
# Prices are found in Stripe by lookup key (pingo_personal_monthly, …) and created
# from the admin panel or `pnpm stripe:setup -- --mode test`. Override only if needed:
# STRIPE_TEST_PRICE_PERSONAL= / STRIPE_TEST_PRICE_PRO= / STRIPE_TEST_PRICE_AGENCY=
# STRIPE_LIVE_PRICE_PERSONAL= / STRIPE_LIVE_PRICE_PRO= / STRIPE_LIVE_PRICE_AGENCY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=PINGO <noreply@localhost>

# Optional Google / Facebook SSO (better-auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CONFIG_ID=

# Optional Sentry
SENTRY_DSN=

# Optional PostHog
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Admin bootstrap (first user with this email becomes ADMIN on seed/startup)
ADMIN_EMAIL=admin@pingo.local

# Admin panel (/admin): login + password for the maintenance toggle and stats.
# Separate from user accounts. Leave empty to disable the panel.
ADMIN_PANEL_LOGIN=
ADMIN_PANEL_PASSWORD=

# Email verification on sign-up: on in production by default.
# Set to true to test the verification flow locally (emails go to the console).
# REQUIRE_EMAIL_VERIFICATION=true

# Plan prices in cents (override defaults if needed)
PLAN_PRICE_PERSONAL=399
PLAN_PRICE_PRO=899
PLAN_PRICE_AGENCY=1999
